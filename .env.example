# Copy to .env and fill in values from the DEV Supabase project only.
PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never ship to the app or commit.
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (server only). AI_PROVIDER: gemini | claude | openai | mock
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Browser origins allowed to call the API and open the WebSocket (server only), comma-separated,
# e.g. https://app.example.com,http://localhost:*   (":*" accepts any port on that host).
# Empty: in production no browser origin is allowed; in development (NODE_ENV not "production")
# localhost, 127.0.0.1 and [::1] on any port are allowed, so `flutter run -d chrome` works.
# A bare * is ignored. Native mobile clients send no Origin header and are not affected.
CORS_ALLOWED_ORIGINS=

# Reference USD->PEN rate used to plan goals written in dollars (optional, default 3.75)
USD_PEN_RATE=
