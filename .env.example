# Copy to .env and fill in values from the DEV Supabase project only.
PORT=3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never ship to the app or commit.
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (server only). AI_PROVIDER: gemini | claude | openai | mock
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# WebSocket CORS allowlist (server only): comma-separated browser origins, e.g.
# https://app.example.com,http://localhost:3000. Empty = no browser origin can open
# the WebSocket. A bare * is ignored. Native mobile clients are not affected.
CORS_ALLOWED_ORIGINS=
